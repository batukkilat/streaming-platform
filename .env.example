# Copy this file to .env and adjust for your environment.
# .env is git-ignored and must never be committed.

# ── Broker ────────────────────────────────────────────────────────────────────
# From the host machine:            localhost:19092
# From inside the compose network:  redpanda:9092
BOOTSTRAP_SERVERS=localhost:19092

# ── Topics ────────────────────────────────────────────────────────────────────
# Used by pubsub/json (plain confluent-kafka producer/consumer)
TOPIC=stock_topic_test
# Used by pyspark/ (Structured Streaming pipeline)
SPARK_TOPIC=stock_json_topic_spark

# ── Client identifiers ────────────────────────────────────────────────────────
PRODUCER_CLIENT_ID=python-producer
CONSUMER_GROUP_ID=python-consumer
AUTO_OFFSET_RESET=latest

# ── Producer volume ───────────────────────────────────────────────────────────
# Number of records the pyspark producer emits, and the gap between them.
PRODUCE_COUNT=20000
PRODUCE_INTERVAL_SECONDS=1

# ── Redpanda advertised address (compose only) ────────────────────────────────
# Static IP the broker is given on the compose network and advertises to
# clients. Only needed for docker/redpanda/docker-compose-spark.yml, and only
# if 172.24.1.x collides with something on your machine.
# Pass it through with:  docker compose --env-file ../../.env -f <file> up -d
REDPANDA_ADDR=172.24.1.4
